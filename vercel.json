{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron?etapa=cacar", "schedule": "0 9 * * *" },
    { "path": "/api/cron?etapa=sinais", "schedule": "0 15 * * *" }
  ]
}
